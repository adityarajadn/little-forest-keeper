theme_override_font_sizes/font_size = 13
text = "Animals do not spawn manually. Watch what happens when you place an Acorn. A Squirrel will come, pick it up, and plant a seed. The seed grows into a Bush & Tree, attracting Rabbits. The presence of Rabbits attracts Foxes, while a balanced ecosystem eventually attracts Deer!"
